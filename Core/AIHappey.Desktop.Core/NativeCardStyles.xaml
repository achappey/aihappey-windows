<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Scoped, compiled styles: no application-wide overrides or replacement control templates. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="NativeCardStrokeBrush" Color="{ThemeResource CardStrokeColorDefault}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <!-- Keep non-interactive surfaces distinguishable in every Windows contrast theme. -->
            <SolidColorBrush x:Key="NativeCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <CornerRadius x:Key="NativeCardCornerRadius">8</CornerRadius>
    <Thickness x:Key="NativeCardContentPadding">16</Thickness>
    <Style x:Key="NativeCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NativeCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NativeCardCornerRadius}" />
    </Style>
    <Style x:Key="NativeCardInsetStyle" TargetType="Border" BasedOn="{StaticResource NativeCardStyle}">
        <Setter Property="Padding" Value="{StaticResource NativeCardContentPadding}" />
    </Style>
    <Style x:Key="NativeCardDividerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="NativeCardBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style x:Key="NativeCardSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="NativeCardMetadataStyle" TargetType="TextBlock" BasedOn="{StaticResource NativeCardSecondaryTextStyle}">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="NativeCardActionStyle" TargetType="Button">
        <!-- Retain the stock Button template and its theme-aware hover/pressed/disabled/focus states. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="NativeCardImageMetadataStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style x:Key="NativeCardImageContainerStyle" TargetType="GridViewItem">
        <!-- Native item presenter owns pointer feedback, keyboard activation and focus. -->
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{StaticResource NativeCardCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
</ResourceDictionary>
