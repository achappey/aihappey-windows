<UserControl
    x:Class="AIHappey.Desktop.Core.ImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///AIHappey.Desktop.Core/NativeCardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True">
        <GridView x:Name="LibraryGrid" SelectionMode="None" IsItemClickEnabled="True"
                  ItemContainerStyle="{StaticResource NativeCardImageContainerStyle}"
                  HorizontalAlignment="Stretch" Margin="24,0,24,16"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <GridView.Header>
                <StackPanel x:Name="Header" Spacing="12" Margin="0,28,0,20">
                    <StackPanel x:Name="PromptPanel" Spacing="8" MaxWidth="1056" HorizontalAlignment="Center">
                        <TextBlock x:Name="Title" FontSize="28" FontWeight="SemiBold" />
                        <ScrollViewer x:Name="TagScroll" MaxHeight="128" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <StackPanel x:Name="Tags" Spacing="4" />
                        </ScrollViewer>
                        <TextBox x:Name="Prompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="240" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddAttachment" Width="40" Height="40" Padding="0"><SymbolIcon Symbol="Add" /></Button>
                            <Button x:Name="Settings" Grid.Column="1" Width="40" Height="40" Padding="0"><SymbolIcon Symbol="Setting" /></Button>
                            <Button x:Name="Stop" Grid.Column="3" Visibility="Collapsed" />
                            <Button x:Name="Send" Grid.Column="4" Width="40" Height="40" Padding="0"><SymbolIcon Symbol="Send" /></Button>
                        </Grid>
                        <TextBlock x:Name="NoModels" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="Notices" Spacing="8" />
                    <Grid Margin="0,24,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibraryTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="OpenFolder" Grid.Column="1" Padding="0" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="EmptyLibrary" TextWrapping="Wrap" />
                </StackPanel>
            </GridView.Header>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" /></ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4" CornerRadius="{StaticResource NativeCardCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Description}" />
                        <ProgressRing IsActive="{Binding Pending}" Visibility="{Binding PendingVisibility}" Width="32" Height="32" />
                        <Border VerticalAlignment="Bottom" Style="{StaticResource NativeCardImageMetadataStyle}" Visibility="{Binding MetadataVisibility}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis" Style="{StaticResource NativeCardMetadataStyle}" />
                                <TextBlock Text="{Binding Cost}" Style="{StaticResource NativeCardMetadataStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource NativeCardStyle}" Background="{x:Null}" IsHitTestVisible="False" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <Border x:Name="DropOutline" IsHitTestVisible="False" Visibility="Collapsed" BorderThickness="2" CornerRadius="8" Margin="8" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" />
    </Grid>
</UserControl>
