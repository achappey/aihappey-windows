<UserControl x:Class="AIHappey.Desktop.Core.TranscriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///AIHappey.Desktop.Core/NativeCardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True">
        <GridView x:Name="LibraryGrid" SelectionMode="None" Margin="24,0,24,16"
            ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <GridView.Header>
                <StackPanel x:Name="Header" Spacing="12" Margin="0,28,0,20">
                    <StackPanel x:Name="InputPanel" Spacing="12" MaxWidth="1056" HorizontalAlignment="Center">
                        <TextBlock x:Name="Title" FontSize="28" FontWeight="SemiBold" />
                        <Border Padding="20" Style="{StaticResource NativeCardStyle}">
                            <StackPanel Spacing="8">
                                <ic:FluentIcon Icon="Mic" FontSize="28" HorizontalAlignment="Left" />
                                <TextBlock x:Name="DropHint" TextWrapping="Wrap" />
                                <TextBlock x:Name="FileHint" TextWrapping="Wrap" Style="{StaticResource NativeCardMetadataStyle}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddFiles"><ic:FluentIcon Icon="Attach" /></Button>
                            <Button x:Name="Settings"><ic:FluentIcon Icon="Settings" /></Button>
                            <Button x:Name="Stop" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="NoModels" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="Notices" Spacing="8" />
                    <Grid Margin="0,24,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibraryTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="OpenFolder" Grid.Column="1" Padding="0" />
                    </Grid>
                    <TextBlock x:Name="EmptyLibrary" TextWrapping="Wrap" />
                </StackPanel>
            </GridView.Header>
            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" /></ItemsPanelTemplate></GridView.ItemsPanel>
        </GridView>
        <Border x:Name="DropOutline" IsHitTestVisible="False" Visibility="Collapsed" BorderThickness="2" CornerRadius="8" Margin="8" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" />
    </Grid>
</UserControl>
