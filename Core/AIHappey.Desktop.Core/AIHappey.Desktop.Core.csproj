    <PackageReference Include="FluentIcons.WinUI" Version="2.2.343" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.4-experimental" />
    <PackageReference Include="CommunityToolkit.Labs.WinUI.Controls.MarkdownTextBlock" Version="0.1.260915-build.2673" />
