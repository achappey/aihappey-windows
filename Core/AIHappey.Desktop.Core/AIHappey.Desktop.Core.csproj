<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultLanguage>en</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\FishAudio\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <None Remove="ProviderCatalog\ProviderCatalog.sha256" />
    <None Include="ProviderCatalog\ProviderCatalog.sha256" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="ProviderCatalog.sha256" />
    <EmbeddedResource Include="AgentProviderDefaults.json" LogicalName="Desktop.AgentProviderDefaults" />
    <EmbeddedResource Include="LocalToolDefinitions.json" LogicalName="Desktop.LocalToolDefinitions" />
    <EmbeddedResource Include="DesktopToolDefinitions.json" LogicalName="Desktop.DesktopToolDefinitions" />
    <!-- x:Uid in this library resolves through the library's native resource scope. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.3.260402-preview2" />
    <PackageReference Include="Flags.Icons.WinUi" Version="3.4.3" />
    <PackageReference Include="FluentIcons.WinUI" Version="2.2.345" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.4-experimental" />
    <PackageReference Include="CommunityToolkit.Labs.WinUI.Controls.MarkdownTextBlock" Version="0.1.261027-build.2704" />
    <PackageReference Include="PdfPig" Version="0.1.17-alpha-202610280031-86fd0" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="SIPSorcery.OpenAI.Realtime" Version="10.0.18-pre" />
    <PackageReference Include="SIPSorceryMedia.Windows" Version="10.0.18-pre" />
    <PackageReference Include="System.Data.OleDb" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0-rc.3.26522.148" />
    <ProjectReference Include="..\..\..\aihappey-ai\Core\AIHappey.Vercel\AIHappey.Vercel.csproj" />
    <ProjectReference Include="..\..\..\aihappey-agents\core\AgentHappey.Common\AgentHappey.Common.csproj" />
  </ItemGroup>
  <Import Project="DocumentExtraction.Packages.props" />
  <Target Name="VerifyFishAudioTransportAssets" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\Tests\check-fishaudio-assets.ps1&quot;" />
  </Target>
</Project>
