<UserControl x:Class="AIHappey.Desktop.Core.SpeechPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///AIHappey.Desktop.Core/NativeCardStyles.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True">
        <GridView x:Name="LibraryGrid" SelectionMode="None" Margin="24,0,24,16" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <GridView.Header>
                <StackPanel x:Name="Header" Spacing="12" Margin="0,28,0,20">
                    <StackPanel x:Name="PromptPanel" Spacing="8" MaxWidth="1056" HorizontalAlignment="Center">
                        <TextBlock x:Name="Title" FontSize="28" FontWeight="SemiBold" />
                        <TextBox x:Name="Prompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="280" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button x:Name="Settings" Width="40" Height="40" Padding="0"><ic:FluentIcon Icon="Settings"/></Button>
                            <Button x:Name="Import" Grid.Column="1" Width="40" Height="40" Padding="0"><ic:FluentIcon Icon="Attach"/></Button>
                            <Button x:Name="Dictate" Grid.Column="3" Width="40" Height="40" Padding="0"><ic:FluentIcon Icon="Mic"/></Button>
                            <Button x:Name="Stop" Grid.Column="4" Visibility="Collapsed" />
                            <Button x:Name="Send" Grid.Column="5" Width="40" Height="40" Padding="0"><ic:FluentIcon Icon="Send"/></Button>
                        </Grid>
                        <TextBlock x:Name="NoModels" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="Notices" Spacing="8" />
                    <Grid Margin="0,24,0,0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibraryTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="OpenFolder" Grid.Column="1" Padding="0" />
                    </Grid>
                    <TextBlock x:Name="EmptyLibrary" TextWrapping="Wrap" />
                </StackPanel>
            </GridView.Header>
            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"/></ItemsPanelTemplate></GridView.ItemsPanel>
        </GridView>
        <Border x:Name="DropOutline" IsHitTestVisible="False" Visibility="Collapsed" BorderThickness="2" CornerRadius="8" Margin="8" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"/>
    </Grid>
</UserControl>
